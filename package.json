    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node --test"
  },
  "engines": {
    "node": ">=18.17"
  },
  "dependencies": {
    "cross-spawn": "7.0.6"
  },
  "keywords": [
    "api-key",
    "secrets",
    "keychain",
    "credential-manager",
    "libsecret",
    "ai-agents",
    "claude-code",
    "codex",
    "cursor"
  ],
